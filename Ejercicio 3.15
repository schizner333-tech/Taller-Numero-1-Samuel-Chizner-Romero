#include <iostream>
#include <math.h>
using namespace std;

int main()
{
    // Variables
    
    int mes;
    
    // Leer/Solicitar
    
    cout<<"Ingresa el numero del mes (1 a 12): ";
    cin>>mes;
    
    // Calcular y Mostrar
    
    if (mes == 1 || mes == 3 || mes == 5 || mes == 7 || mes == 8 || mes == 10 || mes == 12)
    {
        cout<<"El mes tiene 31 dias.\n";
    }
    else if (mes == 4 || mes == 6 || mes == 9 || mes == 11)
    {
        cout<<"El mes tiene 30 dias.\n";
    }
    else if (mes == 2)
    {
        cout<<"El mes tiene 28 dias.\n";
    }
    else
    {
        cout<<"Numero de mes invalido. Debe ser un numero del 1 al 12.\n";
    }
}
